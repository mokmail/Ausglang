# Copy to .env and adjust for your machine.
#
# Where the SGLang OpenAI API lives.
#   macOS / Windows (Docker Desktop): http://host.docker.internal:43440
#   Linux with the GPU profile:       http://sglang:30000
#   Linux, SGLang on the host:        http://host.docker.internal:43440
UPSTREAM=http://host.docker.internal:43440

# Published UI port.
WORKBENCH_PORT=8090

# Require X-API-Key on /api/* (leave empty to disable).
WORKBENCH_API_KEY=

# Comma-separated allowed origins for browser clients.
WORKBENCH_CORS_ORIGINS=*

# Host path of the HuggingFace cache, mounted read-only so the model browser can
# list what you already downloaded.
HF_CACHE_DIR=/Users/kmail/.cache/huggingface

# Host-side loader agent (run ./run-loader.sh on the host). With this set, the
# container can start/stop/switch models: calls are forwarded to the host, where
# Metal actually exists. Use the host's LAN IP when host.docker.internal fails.
WORKBENCH_LOADER_URL=http://192.168.1.50:43441
WORKBENCH_LOADER_TOKEN=

# Interpreter that can run `sglang.launch_server` *inside the container*.
# Leave empty on macOS/Windows: model loading is then refused with HTTP 501 and
# you start SGLang on the host instead.
SGLANG_PYTHON=

# GPU profile only
MODEL=Qwen/Qwen3-1.7B
MEM_FRACTION=0.85
HF_TOKEN=
TZ=Europe/Vienna
