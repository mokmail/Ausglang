# SGLang Workbench — compose settings.
# `./start-workbench.sh` writes this file for you, with this machine's address.
# Everything has a working default; override only what you need.

# ---- engine -----------------------------------------------------------------
# Address of the SGLang OpenAI API as seen *from inside the container*.
# Leave the default on Docker Desktop; on Rancher/Colima set the host's LAN IP
# (the start script does this automatically).
UPSTREAM=http://host.docker.internal:43440

# Extra addresses to probe if UPSTREAM does not answer, comma separated.
# WORKBENCH_UPSTREAMS=http://192.168.1.80:43440,http://172.17.0.1:43440

# Optional host-side loader (loader_agent.py). Enables "Load model" in the UI.
# WORKBENCH_LOADER_URL=http://192.168.1.80:43441
# WORKBENCH_LOADER_TOKEN=

# ---- app --------------------------------------------------------------------
WORKBENCH_PORT=8090
WORKBENCH_DATA_DIR=./data
# WORKBENCH_API_KEY=
# WORKBENCH_CORS_ORIGINS=*
TZ=Europe/Vienna

# ---- models -----------------------------------------------------------------
# Host HuggingFace cache, mounted read-only so the model browser can list it.
HF_CACHE_DIR=

# GPU profile only (Linux + NVIDIA)
# MODEL=Qwen/Qwen3-1.7B
# MEM_FRACTION=0.85
# SGLANG_PORT=30000
# HF_TOKEN=
